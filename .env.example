# Value Creation Protocol — environment variables
# Copy to .env and fill in values. Never commit .env.

# Sanity CMS — shared project 0efm0pow / dataset production
# Read-only token. All writes go through Canon agent (governance gateway).
# Obtain from Sanity dashboard: Manage → API → Tokens
SANITY_API_READ_TOKEN=

# Optional: site URL override (Vercel sets VERCEL_URL automatically in deploys)
# SITE_URL=https://valuecreationprotocol.com
