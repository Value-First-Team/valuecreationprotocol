{
  "name": "valuecreationprotocol-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "valuecreationprotocol.com — Next.js App Router re-platform (React-first, static export). The open protocol home. Built on @vf/site-kit (React shell) + @vf/ui + @vf/brand + @vf/design-engine. Keeps the site's own VCP protocol-identity token preset; the shell is shared, the identity is this node's.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "card-art": "vf-card-art-build --consumer consumer:valuecreationprotocol/framework-cards --table src/data/card-art-table.json --receipts public/card-asset-receipts.jsonl --by valuecreationprotocol-build",
    "predev": "npm run card-art",
    "dev": "next dev",
    "prebuild": "npm run card-art",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "canon:drift": "node scripts/canon-drift-gate.mjs",
    "canon:refresh": "node scripts/canon-drift-gate.mjs --fix",
    "check": "npm run assert:changelog && node scripts/canon-drift-gate.mjs && next typegen && tsc --noEmit",
    "assert:changelog": "node ../repo-changelog-lint-run.mjs --repo .. --since 72ead37f9a80f9d5838590d0d220783020f2949c --behavior-paths next/src,next/public,next/next.config.ts,next/vercel.json,next/tailwind.config.ts,next/postcss.config.cjs,next/package-lock.json"
  },
  "dependencies": {
    "@vf/brand": "github:Value-First-Team/vf-brand#27489828fe6e6826199fc24ee35cb1e103763878",
    "@vf/design-engine": "github:Value-First-Team/vf-design-engine#5d76302eebbd9a216d4fd846c4575c3ec485a4cc",
    "@vf/recipes": "github:Value-First-Team/vf-recipes#e3f9f14fd0acd0934df78d4be74f99cd29074cba",
    "@vf/site-kit": "github:Value-First-Team/vf-site-kit#145f32a5d320d730e714e4c984db74cc76665418",
    "@vf/ui": "github:Value-First-Team/vf-ui#8306694ead819a374a21226eb5f851736e91539f",
    "@vf/value-path-core": "github:Value-First-Team/vf-value-path-core#280b75a7d1f0d4fccdd2942ece1ec612871f803c",
    "marked": "^14.1.3",
    "next": "^15.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@vf/design-engine": "github:Value-First-Team/vf-design-engine#5d76302eebbd9a216d4fd846c4575c3ec485a4cc",
    "@vf/ui": "github:Value-First-Team/vf-ui#8306694ead819a374a21226eb5f851736e91539f",
    "@vf/brand": "github:Value-First-Team/vf-brand#27489828fe6e6826199fc24ee35cb1e103763878",
    "@vf/recipes": "github:Value-First-Team/vf-recipes#e3f9f14fd0acd0934df78d4be74f99cd29074cba",
    "@vf/site-kit": "github:Value-First-Team/vf-site-kit#145f32a5d320d730e714e4c984db74cc76665418"
  }
}
