---
/**
 * BaseLayout — STUB during Phase 1 rebuild.
 * Hand-crafted version lands in the next commit.
 */
export interface Props {
  title: string;
  description?: string;
  path: string;
  ogImage?: string;
  schemaType?: 'WebPage' | 'DefinedTerm' | 'TechArticle' | 'Article' | 'CollectionPage' | 'DefinedTermSet';
  schemaTermCode?: string;
  schemaDefinedTerms?: Array<{ name: string; description?: string; termCode?: string }>;
  datePublished?: string;
  dateModified?: string;
  minimalNav?: boolean;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} — Value Creation Protocol</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
