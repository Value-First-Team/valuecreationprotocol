---
/**
 * BaseLayout — site-wide HTML shell.
 *
 * Responsibilities:
 * - HTML head: title, description, canonical, OG/Twitter, favicon, JSON-LD
 * - Global typography + design tokens (Tailwind)
 * - Header (nav) + Footer
 * - Slot for page body
 *
 * Reads as a calm protocol home. Mostly neutral surfaces. VF palette (teal/orange/blue)
 * is accent only — never the dominant chrome.
 */
import { SITE, NAV } from '../lib/site';

export interface Props {
  /** Page title (concatenated with "— Value Creation Protocol") */
  title: string;
  /** Meta description */
  description?: string;
  /** Path relative to site root, e.g. "/value-path". Used for canonical + OG URL. */
  path: string;
  /** Filename in /public/og/ — defaults to og-default.jpg. */
  ogImage?: string;
  /** Optional schema.org @type override. Defaults to "WebPage". */
  schemaType?: 'WebPage' | 'DefinedTerm' | 'TechArticle' | 'Article';
  /** Optional schema.org @id (canonical concept URI). */
  schemaTermCode?: string;
}

const {
  title,
  description = SITE.description,
  path,
  ogImage = 'og-default.jpg',
  schemaType = 'WebPage',
  schemaTermCode,
} = Astro.props;

const fullTitle = path === '/' ? `${SITE.name} — Open Protocol Home` : `${title} — ${SITE.name}`;
const canonicalUrl = `${SITE.url}${path}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE.url}/og/${ogImage}`;
// Fallback to hero/og-default if og-{slug}.jpg doesn't exist — handled by file copy at build.
const fallbackOg = `${SITE.url}/hero/og-default.jpg`;

// JSON-LD schema
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
};
if (schemaType === 'DefinedTerm' && schemaTermCode) {
  jsonLd.termCode = schemaTermCode;
  jsonLd.inDefinedTermSet = {
    '@type': 'DefinedTermSet',
    name: 'Value Creation Protocol Glossary',
    url: `${SITE.url}/glossary`,
  };
}
if (schemaType === 'TechArticle' || schemaType === 'Article') {
  jsonLd.headline = title;
  jsonLd.author = {
    '@type': 'Organization',
    name: SITE.implementer.name,
    url: SITE.implementer.url,
  };
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/favicon-180.png" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} — Value Creation Protocol`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style is:global>
      :root {
        --color-ink: #0c0a09;
        --color-text: #1c1917;
        --color-muted: #57534e;
        --color-faint: #78716c;
        --color-line: #e7e5e4;
        --color-line-soft: #f5f5f4;
        --color-surface: #ffffff;
        --color-surface-alt: #fafaf9;
        --color-teal: #0d9488;
        --color-orange: #ea580c;
        --color-blue: #2563eb;
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 17px;
        line-height: 1.7;
        color: var(--color-text);
        background: var(--color-surface);
      }
      h1, h2, h3, h4, h5, h6 {
        color: var(--color-ink);
        line-height: 1.25;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      a {
        color: var(--color-blue);
        text-underline-offset: 3px;
      }
      a:hover {
        color: #1d4ed8;
      }
      code, pre {
        font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
        font-size: 0.9em;
      }
      code {
        background: var(--color-line-soft);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }
      pre {
        background: var(--color-line-soft);
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        line-height: 1.5;
      }
      pre code {
        background: transparent;
        padding: 0;
      }

      /* Prose — applied to rendered markdown bodies */
      .prose {
        max-width: 72ch;
      }
      .prose > * + * { margin-top: 1.2em; }
      .prose h2 {
        font-size: 1.6rem;
        margin-top: 2.4em;
        margin-bottom: 0.6em;
        padding-bottom: 0.3em;
        border-bottom: 1px solid var(--color-line);
      }
      .prose h3 {
        font-size: 1.25rem;
        margin-top: 2em;
        margin-bottom: 0.5em;
      }
      .prose h4 {
        font-size: 1.05rem;
        margin-top: 1.6em;
        margin-bottom: 0.4em;
      }
      .prose p, .prose li {
        font-size: 1.0625rem;
        line-height: 1.75;
      }
      .prose ul, .prose ol {
        padding-left: 1.4em;
      }
      .prose li + li { margin-top: 0.4em; }
      .prose blockquote {
        margin: 1.4em 0;
        padding: 0.6em 1.2em;
        border-left: 3px solid var(--color-teal);
        background: var(--color-line-soft);
        color: var(--color-text);
        font-style: normal;
      }
      .prose blockquote p { margin: 0; }
      .prose hr {
        border: 0;
        border-top: 1px solid var(--color-line);
        margin: 2.4em 0;
      }
      .prose strong { color: var(--color-ink); font-weight: 600; }
      .prose table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
        margin: 1.4em 0;
      }
      .prose th, .prose td {
        text-align: left;
        padding: 0.6em 0.8em;
        border-bottom: 1px solid var(--color-line);
        vertical-align: top;
      }
      .prose th {
        background: var(--color-line-soft);
        font-weight: 600;
      }

      /* Skip link */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      .skip-link:focus {
        position: absolute;
        left: 1rem;
        top: 1rem;
        background: var(--color-ink);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        z-index: 1000;
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="border-b border-stone-200 bg-white/95 backdrop-blur sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-2 no-underline group">
          <span class="text-[15px] font-semibold tracking-tight text-stone-900 group-hover:text-stone-700">
            Value Creation Protocol
          </span>
          <span class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-widest text-vcp-teal border border-vcp-teal/40 rounded px-1.5 py-0.5">
            v0.1
          </span>
        </a>
        <nav class="hidden md:flex items-center gap-7 text-[14px] font-medium">
          {NAV.map((item) => (
            <a
              href={item.href}
              class="text-stone-700 hover:text-stone-900 no-underline"
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="md:hidden">
          <details class="relative">
            <summary class="list-none cursor-pointer text-stone-700 text-sm">Menu</summary>
            <div class="absolute right-0 mt-2 w-56 bg-white border border-stone-200 rounded-md shadow-lg p-3 flex flex-col gap-2">
              {NAV.map((item) => (
                <a href={item.href} class="text-sm text-stone-700 no-underline py-1.5 px-2 hover:bg-stone-50 rounded">
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-stone-200 bg-stone-50">
      <div class="max-w-7xl mx-auto px-6 py-12 grid gap-10 md:grid-cols-4">
        <div class="md:col-span-2">
          <p class="text-[15px] font-semibold text-stone-900 m-0">
            Value Creation Protocol
          </p>
          <p class="text-sm text-stone-600 mt-2 mb-0 max-w-md">
            An open protocol for designing systems where value flows naturally between
            people, organizations, and AI. A peer to
            <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener" class="text-stone-700 underline">
              modelcontextprotocol.io
            </a>
            and the emerging Human Context Protocol.
          </p>
          <p class="text-sm text-stone-600 mt-4 mb-0">
            Originated and canonically implemented by
            <a href={SITE.implementer.url} target="_blank" rel="noopener" class="text-stone-700 underline">
              Value-First Team
            </a>.
            The protocol itself is open.
          </p>
        </div>

        <div>
          <p class="text-[11px] uppercase tracking-widest text-stone-500 font-semibold m-0">
            Read
          </p>
          <ul class="mt-3 space-y-2 text-sm list-none p-0">
            <li><a href="/" class="text-stone-700 no-underline hover:underline">Protocol overview</a></li>
            <li><a href="/encoding-stack" class="text-stone-700 no-underline hover:underline">Encoding stack</a></li>
            <li><a href="/methodology" class="text-stone-700 no-underline hover:underline">Methodology canon</a></li>
            <li><a href="/manifestos" class="text-stone-700 no-underline hover:underline">Manifestos</a></li>
            <li><a href="/glossary" class="text-stone-700 no-underline hover:underline">Glossary</a></li>
          </ul>
        </div>

        <div>
          <p class="text-[11px] uppercase tracking-widest text-stone-500 font-semibold m-0">
            Engage
          </p>
          <ul class="mt-3 space-y-2 text-sm list-none p-0">
            <li><a href="/engagement" class="text-stone-700 no-underline hover:underline">Read · Implement · Contribute</a></li>
            <li><a href={SITE.implementer.url} target="_blank" rel="noopener" class="text-stone-700 no-underline hover:underline">Canonical implementer</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-stone-200">
        <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs text-stone-500">
          <p class="m-0">
            The protocol is open. Documentation © Value-First Team. Concepts free to implement.
          </p>
          <p class="m-0 font-mono">
            VCP v0.1 · 2026
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
