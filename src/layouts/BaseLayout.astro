---
/**
 * BaseLayout — site-wide HTML shell for valuecreationprotocol.com.
 *
 * Hand-crafted Astro + Tailwind. Design tokens live in src/styles/tokens.css
 * and are surfaced via:
 *   1. CSS-variable–backed Tailwind utilities (bg-vcp-paper, text-vcp-ink, etc.)
 *   2. Token utility classes defined in tokens.css (.t-display, .t-lead,
 *      .t-eyebrow, .vcp-btn, .vcp-status-pill, .vcp-eyebrow)
 *
 * NO arbitrary-value Tailwind classes (e.g. min-h-[44px], text-[clamp(...)]).
 * NO archetypes.css / sections.css / doc.css imports.
 * Typography uses the token classes; colors use named utilities.
 *
 * Responsibilities:
 *   - HTML head: meta, OG, JSON-LD per page (TR-8: canonical to vcp.com only)
 *   - Google Fonts (Newsreader display + prose, Geist UI, Geist Mono)
 *   - tokens.css load (once, globally)
 *   - Header chrome (nav + mark lockup + status badge)
 *   - Footer chrome (implementer attribution + link grid + meta)
 *   - <slot /> for page body
 */
import { SITE, NAV } from '../lib/site';
import '../styles/tokens.css';

export interface Props {
  /** Page title (concatenated with " — Value Creation Protocol") */
  title: string;
  /** Meta description */
  description?: string;
  /** Path relative to site root, e.g. "/value-path". Used for canonical + OG URL. */
  path: string;
  /** Filename in /public/og/ — defaults to og-default.jpg. */
  ogImage?: string;
  /** Optional schema.org @type override. Defaults to "WebPage". */
  schemaType?: 'WebPage' | 'DefinedTerm' | 'TechArticle' | 'Article' | 'CollectionPage' | 'DefinedTermSet';
  /** Optional schema.org termCode (short identifier for DefinedTerm). */
  schemaTermCode?: string;
  /** For DefinedTerm pages: additional DefinedTerm entries embedded in the JSON-LD graph. */
  schemaDefinedTerms?: Array<{ name: string; description?: string; termCode?: string }>;
  /** For TechArticle/Article: ISO date. */
  datePublished?: string;
  /** For TechArticle/Article: ISO date. */
  dateModified?: string;
  /** Suppress the standard header chrome (manifesto archetype uses minimal). */
  minimalNav?: boolean;
}

const {
  title,
  description = SITE.description,
  path,
  ogImage = 'og-default.jpg',
  schemaType = 'WebPage',
  schemaTermCode,
  schemaDefinedTerms,
  datePublished,
  dateModified,
  minimalNav = false,
} = Astro.props;

const fullTitle = path === '/' ? `${SITE.name} — Open Protocol Home` : `${title} — ${SITE.name}`;
// Canonical URL: derived from SITE.url + path. NEVER cross-domain (TR-8 hard rule).
const canonicalUrl = `${SITE.url}${path}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE.url}/og/${ogImage}`;

// JSON-LD schema. Each branch adds type-specific properties.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  description,
  url: canonicalUrl,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'en',
  },
};

if (schemaType === 'DefinedTerm') {
  if (schemaTermCode) jsonLd.termCode = schemaTermCode;
  jsonLd.inDefinedTermSet = {
    '@type': 'DefinedTermSet',
    name: 'Value Creation Protocol Glossary',
    url: `${SITE.url}/glossary`,
  };
}

if (schemaType === 'TechArticle' || schemaType === 'Article') {
  jsonLd.headline = title;
  jsonLd.author = {
    '@type': 'Organization',
    name: SITE.implementer.name,
    url: SITE.implementer.url,
  };
  jsonLd.publisher = {
    '@type': 'Organization',
    name: SITE.implementer.name,
    url: SITE.implementer.url,
  };
  if (datePublished) jsonLd.datePublished = datePublished;
  if (dateModified) jsonLd.dateModified = dateModified;
}

const auxDefinedTerms =
  schemaDefinedTerms && schemaDefinedTerms.length > 0
    ? {
        '@context': 'https://schema.org',
        '@graph': schemaDefinedTerms.map((t) => ({
          '@type': 'DefinedTerm',
          name: t.name,
          description: t.description,
          termCode: t.termCode,
          inDefinedTermSet: {
            '@type': 'DefinedTermSet',
            name: 'Value Creation Protocol Glossary',
            url: `${SITE.url}/glossary`,
          },
        })),
      }
    : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/favicon-180.png" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} — Value Creation Protocol`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: Newsreader (display + prose, opsz 6-72, weights 300-700),
         Geist (UI/body), Geist Mono (technical). Preconnect-optimized. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500;6..72,600;6..72,700&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {auxDefinedTerms && (
      <script type="application/ld+json" set:html={JSON.stringify(auxDefinedTerms)} />
    )}
  </head>
  <body class="bg-vcp-surface text-vcp-ink">
    <a href="#main" class="skip-link">Skip to content</a>

    {!minimalNav && (
      <header class="vcp-nav">
        <div class="vcp-nav-inner">
          <a href="/" class="vcp-nav-lockup">
            <img
              src="/assets/marks/vcp-mark-tight.png"
              alt=""
              width="40"
              height="40"
              class="vcp-nav-mark"
            />
            <span class="vcp-nav-wordmark">
              <span class="vcp-nav-wordmark-row">Value Creation Protocol</span>
            </span>
          </a>

          <nav class="vcp-nav-links" aria-label="Primary">
            {NAV.map((item) => (
              <a href={item.href} class="vcp-nav-link">{item.label}</a>
            ))}
          </nav>

          <div class="vcp-nav-status">
            <span class="vcp-status-pill">v0.1 · DRAFT</span>
          </div>

          <details class="vcp-nav-mobile">
            <summary class="vcp-nav-mobile-trigger">Menu</summary>
            <div class="vcp-nav-mobile-panel">
              {NAV.map((item) => (
                <a href={item.href} class="vcp-nav-mobile-link">{item.label}</a>
              ))}
              <div class="vcp-nav-mobile-status">
                <span class="vcp-status-pill">v0.1 · DRAFT</span>
              </div>
            </div>
          </details>
        </div>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="vcp-foot">
      <div class="vcp-foot-inner">
        <div class="vcp-foot-attribution">
          <p class="vcp-foot-eyebrow">Protocol home</p>
          <p class="vcp-foot-body">
            Operated and refined by{' '}
            <a href={SITE.implementer.url} target="_blank" rel="noopener" class="vcp-foot-link">Value-First Team</a>
            {' '}— the originating and canonical implementing firm. The Value Creation Protocol is
            published openly; anyone may read, cite, and operate on it independently of firm engagement.
          </p>
        </div>

        <div class="vcp-foot-bottom">
          <div class="vcp-foot-links">
            <a href="/protocol-stack" class="vcp-foot-bottom-link">Protocol stack</a>
            <a href="/encoding-stack" class="vcp-foot-bottom-link">Encoding stack</a>
            <a href="/methodology" class="vcp-foot-bottom-link">Methodology</a>
            <a href="/manifestos" class="vcp-foot-bottom-link">Manifestos</a>
            <a href="/glossary" class="vcp-foot-bottom-link">Glossary</a>
            <a href="/sitemap" class="vcp-foot-bottom-link">Sitemap</a>
          </div>
          <p class="vcp-foot-meta">VCP v0.1 · 2026</p>
        </div>
      </div>
    </footer>

    <style is:global>
      /* ============================================================
         Chrome — hand-crafted, references tokens.css variables.
         Authoritative CSS for nav and footer. No Tailwind arbitrary
         values; no inline style attributes for type properties.
         ============================================================ */

      /* ============= Nav ============= */
      .vcp-nav {
        background: rgba(251, 250, 247, 0.95);
        border-bottom: 1px solid var(--vcp-border);
        backdrop-filter: saturate(180%) blur(8px);
        -webkit-backdrop-filter: saturate(180%) blur(8px);
        position: sticky;
        top: 0;
        z-index: 40;
      }
      .vcp-nav-inner {
        max-width: var(--vcp-max-content);
        margin: 0 auto;
        padding: 0.875rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }
      .vcp-nav-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        text-decoration: none;
        color: var(--vcp-ink);
        min-height: 2.75rem;
      }
      .vcp-nav-mark {
        width: 32px;
        height: 32px;
        display: block;
      }
      .vcp-nav-wordmark {
        display: inline-flex;
        flex-direction: column;
        line-height: 1;
      }
      .vcp-nav-wordmark-row {
        font-family: var(--vcp-font-display);
        font-weight: 500;
        font-size: 1rem;
        letter-spacing: -0.005em;
        color: var(--vcp-ink);
        font-variation-settings: "opsz" 16;
      }
      .vcp-nav-links {
        display: none;
        align-items: center;
        gap: 0.125rem;
      }
      .vcp-nav-link {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 0.875rem;
        font-family: var(--vcp-font-body);
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--vcp-ink-2);
        text-decoration: none;
        transition: color var(--vcp-t-fast);
      }
      .vcp-nav-link:hover { color: var(--vcp-ink); }
      .vcp-nav-status {
        display: none;
        align-items: center;
      }
      .vcp-nav-mobile {
        position: relative;
      }
      .vcp-nav-mobile-trigger {
        list-style: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 0.625rem;
        font-family: var(--vcp-font-body);
        font-size: 0.9375rem;
        color: var(--vcp-ink-2);
      }
      .vcp-nav-mobile-trigger::-webkit-details-marker { display: none; }
      .vcp-nav-mobile-panel {
        position: absolute;
        right: 0;
        top: calc(100% + 0.25rem);
        width: 14rem;
        background: var(--vcp-paper);
        border: 1px solid var(--vcp-border);
        border-radius: var(--vcp-r-md);
        box-shadow: var(--vcp-shadow-md);
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        z-index: 50;
      }
      .vcp-nav-mobile-link {
        display: flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 0.75rem;
        font-family: var(--vcp-font-body);
        font-size: 0.9375rem;
        color: var(--vcp-ink-2);
        text-decoration: none;
        border-radius: var(--vcp-r-sm);
      }
      .vcp-nav-mobile-link:hover {
        background: var(--vcp-surface-2);
        color: var(--vcp-ink);
      }
      .vcp-nav-mobile-status {
        padding: 0.75rem;
        border-top: 1px solid var(--vcp-border);
        margin-top: 0.25rem;
      }

      @media (min-width: 768px) {
        .vcp-nav-links { display: inline-flex; }
        .vcp-nav-status { display: inline-flex; }
        .vcp-nav-mobile { display: none; }
        .vcp-nav-mark { width: 40px; height: 40px; }
        .vcp-nav-wordmark-row { font-size: 1.0625rem; }
      }

      /* ============= Footer ============= */
      .vcp-foot {
        margin-top: 6rem;
        border-top: 1px solid var(--vcp-border);
        background: var(--vcp-surface);
      }
      .vcp-foot-inner {
        max-width: var(--vcp-max-content);
        margin: 0 auto;
        padding: 3.5rem 1.5rem 2.5rem;
      }
      .vcp-foot-attribution {
        max-width: 42rem;
        margin-bottom: 3rem;
      }
      .vcp-foot-eyebrow {
        font-family: var(--vcp-font-mono);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--vcp-ink-4);
        margin: 0 0 0.75rem;
      }
      .vcp-foot-body {
        font-family: var(--vcp-font-display);
        font-size: 1.0625rem;
        line-height: 1.55;
        color: var(--vcp-ink);
        margin: 0;
        font-variation-settings: "opsz" 18;
      }
      .vcp-foot-link {
        color: var(--vcp-teal-deep);
        text-decoration: none;
        border-bottom: 1px solid var(--vcp-teal-deep);
      }
      .vcp-foot-link:hover { color: var(--vcp-link-hover); }
      .vcp-foot-bottom {
        padding-top: 1.75rem;
        border-top: 1px solid var(--vcp-border);
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .vcp-foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
      }
      .vcp-foot-bottom-link {
        font-family: var(--vcp-font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        color: var(--vcp-ink-3);
        text-decoration: none;
      }
      .vcp-foot-bottom-link:hover { color: var(--vcp-ink); }
      .vcp-foot-meta {
        font-family: var(--vcp-font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        color: var(--vcp-ink-4);
        margin: 0;
      }
      @media (min-width: 640px) {
        .vcp-foot-bottom {
          flex-direction: row;
          align-items: flex-end;
          justify-content: space-between;
        }
      }
    </style>
  </body>
</html>
