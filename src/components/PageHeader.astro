---
/**
 * PageHeader — title block at the top of every canon/concept page.
 * Calm. Direct. No marketing decoration.
 */
export interface Props {
  /** Eyebrow text (small, uppercase, above title) — e.g. "Encoding Stack" or "Methodology Canon" */
  eyebrow?: string;
  /** Page title */
  title: string;
  /** Short lede paragraph below title */
  lede?: string;
  /** Optional version tag (shown as monospace pill) */
  version?: string;
  /** Optional status label (e.g. "Approved", "Draft") */
  status?: string;
  /** Effective date or "as of" date */
  effectiveDate?: string;
}

const { eyebrow, title, lede, version, status, effectiveDate } = Astro.props;
---

<header class="border-b border-stone-200 pb-8 mb-12">
  {eyebrow && (
    <p class="text-[11px] uppercase tracking-[0.15em] font-semibold text-vcp-teal m-0 mb-3">
      {eyebrow}
    </p>
  )}
  <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight tracking-tight m-0 text-stone-900">
    {title}
  </h1>
  {lede && (
    <p class="text-lg md:text-xl text-stone-600 mt-5 mb-0 max-w-3xl leading-relaxed">
      {lede}
    </p>
  )}
  {(version || status || effectiveDate) && (
    <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
      {version && (
        <span class="font-mono px-2 py-1 rounded bg-stone-100 text-stone-700 border border-stone-200">
          {version}
        </span>
      )}
      {status && (
        <span class="px-2 py-1 rounded bg-vcp-teal/10 text-vcp-teal border border-vcp-teal/30 font-medium">
          {status}
        </span>
      )}
      {effectiveDate && (
        <span class="text-stone-500">
          Effective {effectiveDate}
        </span>
      )}
    </div>
  )}
</header>
