---
/**
 * CrossCitation — small inline block on canon pages pointing to the
 * canonical implementing firm's peer page on valuefirstteam.com.
 *
 * Mutual cross-citation pattern (TR-9). NOT a canonical link tag —
 * vcp.com remains canonical for itself (TR-8 hard rule, enforced by BaseLayout).
 *
 * Source of truth: the CROSS_CITATIONS map in src/lib/site.ts. Pass the current
 * page path; the component looks up the peer slug + label. If the page has
 * `peerSlug: null` in the map, the component renders nothing — safe to drop
 * on every page unconditionally.
 */
import { getCrossCitation, SITE } from '../lib/site';

export interface Props {
  /** Current page path, e.g. "/value-path". The component looks up the peer. */
  path: string;
}

const { path } = Astro.props;
const entry = getCrossCitation(path);
const peerUrl = entry?.peerSlug ? `${SITE.implementer.url}${entry.peerSlug}` : null;
---

{peerUrl && entry?.peerLabel && (
  <aside class="my-10 p-6 rounded-vcp-lg border border-vcp-border-strong bg-vcp-surface-2">
    <p class="font-mono text-[10px] tracking-[0.12em] uppercase text-vcp-ink-3 m-0 mb-2">
      SEE ALSO
    </p>
    <p class="font-display text-[15px] leading-relaxed text-vcp-ink m-0" style="font-variation-settings: 'opsz' 17">
      <a
        href={peerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-vcp-teal-deep border-b border-vcp-teal-deep/40 no-underline hover:border-vcp-teal-deep"
      >
        {entry.peerLabel}
      </a>
    </p>
  </aside>
)}
