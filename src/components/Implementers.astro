---
/**
 * Implementers — one-line attribution that names Value-First Team as the
 * originating + canonical implementing firm for the Value Creation Protocol.
 *
 * Voice (per "why so serious?" 2026-05 feedback):
 *   - One sentence + link. Not a sales pitch, not a disclaimer.
 *   - Light visual weight. Near page bottom, in an aside, not a banner.
 *   - Single touch per page. Footer + this component is plenty; never both
 *     this AND a separate impl-name in adjacent prose.
 *
 * Used in tandem with CrossCitation on most canon pages:
 *   - CrossCitation = "here's the peer page at valuefirstteam.com"
 *   - Implementers   = "Value-First Team operates the protocol in practice"
 *
 * If a page already has a more elaborate implementers section inline (the
 * homepage dark band, the engagement page), skip this component on that page.
 */
import { SITE } from '../lib/site';

export interface Props {
  /**
   * Optional override for the leading sentence. Defaults to a concise pattern.
   * Keep to one sentence — the component intentionally resists growth.
   */
  variant?: 'default' | 'manifesto';
}

const { variant = 'default' } = Astro.props;
---

<aside class="mt-14 pt-7 border-t border-vcp-border">
  <p class="font-mono text-[10px] tracking-[0.14em] uppercase text-vcp-ink-4 m-0 mb-3">
    PROTOCOL HOME
  </p>
  <p class="font-display text-[16px] leading-[1.55] text-vcp-ink m-0 max-w-[68ch]" style="font-variation-settings: 'opsz' 19">
    {variant === 'manifesto' ? (
      <>
        Written for the Value Creation Protocol — originated and canonically implemented by{' '}
        <a
          href={SITE.implementer.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-vcp-teal-deep border-b border-vcp-teal-deep no-underline"
        >
          Value-First Team
        </a>.
      </>
    ) : (
      <>
        Operated and refined by{' '}
        <a
          href={SITE.implementer.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-vcp-teal-deep border-b border-vcp-teal-deep no-underline"
        >
          Value-First Team
        </a>
        {' '}— the originating and canonical implementing firm. The protocol is published openly;
        anyone may read, cite, and operate on it.
      </>
    )}
  </p>
</aside>
