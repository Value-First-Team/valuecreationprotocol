---
/**
 * /unified-views — Four Unified Views (UCV, URV, UBC, UTE).
 *
 * Renders Sanity unifiedGoal records. Three-Org mapping shown alongside.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import CrossCitation from '../components/CrossCitation.astro';
import Implementers from '../components/Implementers.astro';
import { getUnifiedGoals } from '../lib/sanity/canon';

const goals = await getUnifiedGoals();

// Canonical ordering: UCV, URV, UBC, UTE
const ORDER = ['UCV', 'URV', 'UBC', 'UTE'];
const ordered = [...goals].sort((a, b) => {
  const ai = ORDER.findIndex((k) => a.name?.includes(k));
  const bi = ORDER.findIndex((k) => b.name?.includes(k));
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});
---

<BaseLayout
  title="Four Unified Views"
  description="The visibility framework: UCV, URV, UBC, UTE. Four unified views that an AI-native organization must operate against to avoid fragmented context."
  path="/unified-views"
  ogImage="og-unified-views.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Four Unified Views"
>
  <PageContainer wide>
    <PageHeader
      eyebrow="Methodology Canon"
      title="Four Unified Views"
      lede="UCV, URV, UBC, UTE — the visibility framework. Each view is a unified context surface; together they replace the fragmented dashboards of industrial-age operations."
      status="Canon"
    />

    {ordered.length === 0 ? (
      <p class="text-stone-600 italic">Unified view records loading from canon.</p>
    ) : (
      <div class="space-y-8">
        {ordered.map((g) => (
          <article class="rounded-lg border border-stone-200 overflow-hidden">
            <div
              class="px-6 md:px-8 py-5 border-b border-stone-200"
              style={`background:${g.color?.hex ?? '#0d9488'}10`}
            >
              <div class="flex items-start gap-4">
                <div class="flex-1 min-w-0">
                  <h2 class="text-xl md:text-2xl font-semibold text-stone-900 m-0 leading-tight">
                    {g.name}
                  </h2>
                  {g.primaryOrg && (
                    <p class="mt-2 mb-0 text-sm text-stone-600">
                      <span class="font-mono uppercase tracking-wider text-xs text-stone-500">Primary org:</span>{' '}
                      <strong class="text-stone-800">{g.primaryOrg}</strong>
                    </p>
                  )}
                </div>
              </div>
              {g.description && (
                <p class="text-[15px] text-stone-700 mt-4 mb-0 leading-relaxed">
                  {g.description}
                </p>
              )}
            </div>

            <div class="px-6 md:px-8 py-6 bg-white">
              {g.howItTransforms && (
                <div class="mb-5">
                  <p class="text-[11px] uppercase tracking-[0.15em] font-semibold text-stone-500 m-0 mb-2">
                    How it transforms operations
                  </p>
                  <p class="text-[15px] text-stone-700 m-0 leading-relaxed">
                    {g.howItTransforms}
                  </p>
                </div>
              )}

              {g.keyQuestions && g.keyQuestions.length > 0 && (
                <div class="mb-5">
                  <p class="text-[11px] uppercase tracking-[0.15em] font-semibold text-stone-500 m-0 mb-2">
                    Key questions this view answers
                  </p>
                  <ul class="m-0 mt-2 space-y-1.5 pl-5 text-[15px] text-stone-700">
                    {g.keyQuestions.map((q) => (
                      <li>{q}</li>
                    ))}
                  </ul>
                </div>
              )}

              {g.relatedTraps && g.relatedTraps.length > 0 && (
                <div>
                  <p class="text-[11px] uppercase tracking-[0.15em] font-semibold text-stone-500 m-0 mb-2">
                    Traps this view counters
                  </p>
                  <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
                    {g.relatedTraps.map((t) => (
                      <li>
                        <a
                          href={`/twelve-traps#${t.slug?.current ?? ''}`}
                          class="inline-block px-2.5 py-1 rounded text-xs bg-stone-100 text-stone-700 border border-stone-200 no-underline hover:bg-stone-200"
                        >
                          {t.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <CrossCitation path="/unified-views" />
    <Implementers />
  </PageContainer>
</BaseLayout>
