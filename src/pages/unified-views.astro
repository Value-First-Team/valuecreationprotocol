---
/**
 * /unified-views — Four Unified Views (UCV, URV, UBC, UTE).
 *
 * Source: Sanity unifiedGoal records. Three-Org mapping:
 *   UCV → Customer Org · URV → Finance Org · UBC + UTE → Operations Org.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CanonArchetype from '../components/CanonArchetype.astro';
import { getUnifiedGoals } from '../lib/sanity/canon';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const goals = await getUnifiedGoals();
const ORDER = ['UCV', 'URV', 'UBC', 'UTE'];
const ordered = [...goals].sort((a, b) => {
  const ai = ORDER.findIndex((k) => a.name?.includes(k));
  const bi = ORDER.findIndex((k) => b.name?.includes(k));
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});

const { html: framingHtml } = renderWikiCanonical(WIKI_CANONICAL.unifiedViews);
const framingBody = stripFirstH1(framingHtml);

const viewDefinedTerms = ordered.map((g) => ({
  name: g.name,
  description: g.description,
  termCode: (g.name?.match(/\b([A-Z]{3})\b/)?.[1] ?? '').toLowerCase(),
}));
---

<BaseLayout
  title="Four Unified Views"
  description="UCV, URV, UBC, UTE. The visibility framework — four unified views that an AI-native organization must operate against to refuse the fragmented context of industrial-age dashboards."
  path="/unified-views"
  ogImage="og-unified-views.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Four Unified Views"
  schemaDefinedTerms={viewDefinedTerms}
>
  <CanonArchetype
    eyebrow="Four Unified Views"
    title="Four views that refuse fragmented context."
    lead="UCV, URV, UBC, UTE — Unified Customer View, Unified Revenue View, Unified Business Context, Unified Team Enablement. Each view is a single, addressable surface that an AI-native organization operates against. Together they replace the dashboard sprawl of industrial-age operations with the visibility the Three-Org Model requires."
    path="/unified-views"
    specMeta={[
      { label: 'Status', value: 'canonical' },
      { label: 'Verified', value: '12 May 2026' },
      { label: 'Cite', value: 'valuecreationprotocol.com/unified-views' },
      { label: 'Views', value: `${ordered.length} — UCV · URV · UBC · UTE` },
    ]}
  >
    <section class="canon-prose">
      <p>
        Visibility decides what an organization can act on. The four Unified Views
        are the surfaces against which the Three-Org Model operates: each view is
        complete, integrated, and addressable from one place — not assembled in a
        person's head from seven dashboards.
      </p>
      <p>
        Three-Org mapping is direct: UCV is owned by the Customer Org. URV is owned
        by the Finance Org. UBC and UTE are owned by the Operations Org. A view that
        crosses an org boundary is not a unified view — it is a coordination cost.
      </p>
    </section>

    {ordered.length > 0 && (
      <>
        <p class="canon-section-label">The four, in canonical order</p>
        <h2 class="canon-section-sub">Each view, named and owned.</h2>
        <p class="canon-section-note">
          Sourced from Sanity. Read top to bottom as a complete visibility model.
        </p>

        <ol class="canon-records">
          {ordered.map((g) => {
            const code = g.name?.match(/\b([A-Z]{3})\b/)?.[1] ?? '';
            const slug = code.toLowerCase() || g.name?.toLowerCase().replace(/\s+/g, '-') || 'view';
            return (
              <li class="canon-record" id={slug}>
                <p class="canon-record-eyebrow">{code || 'View'}</p>
                <h3 class="canon-record-title">{g.name}</h3>
                {g.description && (
                  <p class="canon-record-body">{g.description}</p>
                )}
                <div class="canon-record-meta">
                  {g.primaryOrg && (
                    <div>
                      <p class="canon-record-meta-label">Primary org</p>
                      <ul class="canon-record-meta-list">
                        <li>{g.primaryOrg}</li>
                      </ul>
                    </div>
                  )}
                  {g.howItTransforms && (
                    <div>
                      <p class="canon-record-meta-label">How it transforms operations</p>
                      <ul class="canon-record-meta-list">
                        <li>{g.howItTransforms}</li>
                      </ul>
                    </div>
                  )}
                </div>
                {g.keyQuestions && g.keyQuestions.length > 0 && (
                  <div class="canon-record-meta" style="grid-template-columns:1fr">
                    <div>
                      <p class="canon-record-meta-label">Key questions this view answers</p>
                      <ul class="canon-record-meta-list">
                        {g.keyQuestions.map((q) => <li>{q}</li>)}
                      </ul>
                    </div>
                  </div>
                )}
                {g.relatedTraps && g.relatedTraps.length > 0 && (
                  <ul class="canon-record-tags">
                    {g.relatedTraps.map((t) => (
                      <li>
                        <a href={`/twelve-traps#${t.slug?.current ?? ''}`} class="canon-record-tag">
                          <span class="canon-record-tag-label">counters</span>{t.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </>
    )}

    <div class="canon-callout">
      <p class="canon-callout-label">Where this fits</p>
      <p class="canon-callout-body">
        Unified views are operated by the <a href="/three-orgs">Three-Org Model</a>.
        Each view counters a set of <a href="/twelve-traps">Complexity Traps</a> — the
        per-view trap mapping above is canonical, not illustrative.
      </p>
    </div>

    <section class="canon-prose" set:html={framingBody} />
  </CanonArchetype>
</BaseLayout>
