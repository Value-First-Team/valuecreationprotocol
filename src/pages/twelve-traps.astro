---
/**
 * /twelve-traps — Twelve Complexity Traps that derail value creation.
 *
 * Source: Sanity trap records (Tier 1 canonical) ordered alphabetically by name +
 *         wiki canonical reference for the framing prose. Per-trap anchor URLs
 *         so each trap can be cited individually.
 *
 * Note: Trap names that include forbidden vocabulary ("The Leads Trap") are
 * canonical names of the trap that exists to refuse those terms — these are
 * not enforcement violations.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CanonArchetype from '../components/CanonArchetype.astro';
import { getTraps } from '../lib/sanity/canon';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const traps = await getTraps();
const { html: trapOverviewHtml } = renderWikiCanonical(WIKI_CANONICAL.traps);

const trapDefinedTerms = traps.map((t) => ({
  name: t.name,
  description: `Complexity Trap — anti-pattern that derails value-creation work.`,
  termCode: t.slug?.current ?? t.name.toLowerCase().replace(/\s+/g, '-'),
}));
---

<BaseLayout
  title="Twelve Complexity Traps"
  description="Twelve anti-patterns that derail value-creation work. Each names a structural defect AI-native operations must counter. Cited individually by anchor URL."
  path="/twelve-traps"
  ogImage="og-twelve-traps.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Twelve Complexity Traps"
  schemaDefinedTerms={trapDefinedTerms}
>
  <CanonArchetype
    eyebrow="Twelve Complexity Traps"
    title="Twelve patterns that quietly derail value creation."
    lead="Each trap names a structural defect — a habit of language, architecture, or organizational design — that pulls a team back into industrial-age operating logic. Naming them is the first move. The Value Realities counter them one-for-one."
    path="/twelve-traps"
    specMeta={[
      { label: 'Status', value: 'canonical' },
      { label: 'Verified', value: '12 May 2026' },
      { label: 'Cite', value: 'valuecreationprotocol.com/twelve-traps' },
      { label: 'Count', value: `${traps.length} traps · alphabetical` },
    ]}
  >
    {traps.length > 0 && (
      <nav class="canon-index" aria-label="Trap index">
        <p class="canon-index-label">Quick index</p>
        <ol class="canon-index-list">
          {traps.map((t, i) => {
            const slug = t.slug?.current ?? `trap-${i + 1}`;
            return (
              <li>
                <a href={`#${slug}`}>
                  <span class="canon-index-num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{t.name}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </nav>
    )}

    <section class="canon-prose">
      <p>
        Every trap is a name for a habit that survived from the industrial age.
        Some are language traps — words that smuggle in a worldview. Some are
        architectural — data shapes that fragment context. Some are organizational —
        team designs that optimize for the wrong thing.
      </p>
      <p>
        Naming each one out loud is the precondition for refusing it. The Twelve
        Traps catalog gives a team shared vocabulary for that refusal. A practitioner
        in a client meeting can point to a single trap by URL and say: this is the
        shape I am refusing to import into your operating model.
      </p>
    </section>

    {traps.length > 0 && (
      <>
        <p class="canon-section-label">The twelve, in canonical order</p>
        <h2 class="canon-section-sub">Each trap, named and addressable.</h2>
        <p class="canon-section-note">
          Sourced from Sanity. Ordered alphabetically. Each carries its own anchor.
        </p>

        <ol class="canon-records">
          {traps.map((t, i) => {
            const slug = t.slug?.current ?? `trap-${i + 1}`;
            return (
              <li class="canon-record" id={slug}>
                <p class="canon-record-eyebrow">Trap {String(i + 1).padStart(2, '0')}</p>
                <h3 class="canon-record-title">{t.name}</h3>
                <p class="canon-record-body">
                  A pattern that derails value-creation work. See the canonical reference
                  below for the long-form diagnostic, the signals that surface it, and
                  the Reality that counters it.
                </p>
                {t.assessmentPath && (
                  <ul class="canon-record-tags">
                    <li>
                      <a
                        href={`https://valuefirstteam.com${t.assessmentPath}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="canon-record-tag">
                        <span class="canon-record-tag-label">assess</span>self-assessment
                      </a>
                    </li>
                    <li>
                      <a href={`/realities#${slug}`} class="canon-record-tag">
                        <span class="canon-record-tag-label">counter</span>related reality
                      </a>
                    </li>
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </>
    )}

    <div class="canon-callout">
      <p class="canon-callout-label">The pattern beneath the patterns</p>
      <p class="canon-callout-body">
        Every trap shares the same deep structure: it preserves an industrial-age
        habit by giving it a polite, professional name. Below is the long-form
        canonical reference — the framework that produced the list.
      </p>
    </div>

    <section class="canon-prose" set:html={stripFirstH1(trapOverviewHtml)} />
  </CanonArchetype>
</BaseLayout>
