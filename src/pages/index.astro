---
/**
 * Homepage — protocol overview at /
 *
 * Architecture follows Claude Design's Homepage.jsx archetype:
 *   - Hero with "At a glance" sidecar (Status / Verified / Canon pages / Peers / License)
 *   - § 01 The Stack — three peer protocols, no hierarchy implied
 *   - § 02 Enter here — three entry-point cards (encoding stack, methodology, manifestos)
 *   - Five load-bearing claims (retained from prior content; re-skinned)
 *   - Implementers band (retained; warm-paper variant)
 *
 * Tone: peer-level, calm, technical. Not a sales surface.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { AT_A_GLANCE, ENTRY_CARDS } from '../data/homepage';
import ProtocolStackDiagram from '../components/ProtocolStackDiagram.astro';

const FIVE_CLAIMS = [
  {
    n: '01',
    title: 'Mutual Value Creation',
    body: 'Value is created across stakeholders, not extracted from them. Customers, employees, operators, and the organization itself are all participants.',
  },
  {
    n: '02',
    title: 'Context as Substrate',
    body: 'Context is not an input to operations — it is the substrate on which operations run. Fragmented context produces fragmented operations.',
  },
  {
    n: '03',
    title: 'Configuration Over Customization',
    body: 'Configure native platform capability rather than customize bespoke architecture. Custom architecture creates consultant dependency; configuration leverages platform investment.',
  },
  {
    n: '04',
    title: 'Relationships Over Transactions',
    body: 'Relationships are the unit of value creation; transactions are events within relationships. Optimize for relationship trajectory.',
  },
  {
    n: '05',
    title: 'Just-In-Time Over Just-In-Case',
    body: 'Operations deliver capability when needed, not accumulate it against hypothetical need. Just-In-Case operations produce platform sprawl and integration debt.',
  },
];
---

<BaseLayout
  title="Open protocol home"
  description="The Value Creation Protocol (VCP) is an open framework for designing systems where value flows naturally between people, organizations, and AI. A peer to MCP and HCP in the AI-native protocol stack."
  path="/"
  ogImage="og-home.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="VCP"
>
  <!-- ============= HERO ============= -->
  <section class="border-b border-vcp-border">
    <div class="max-w-vcp-content mx-auto px-6 pt-16 pb-14 md:pt-24 md:pb-20">
      <div class="grid lg:grid-cols-[1.3fr_1fr] gap-10 lg:gap-20 items-start">
        <div>
          <p class="vcp-eyebrow m-0 mb-8">
            <span>An open protocol · v0.1</span>
          </p>
          <h1
            class="font-display text-[clamp(2.75rem,7vw,5.5rem)] font-medium leading-[1.02] tracking-vcp-display text-vcp-ink m-0 max-w-[12ch]"
            style="font-variation-settings: 'opsz' 72"
          >
            Value, drawn open and <em class="text-vcp-teal-deep italic font-normal">operable.</em>
          </h1>
          <p
            class="font-display text-[22px] leading-[1.5] text-vcp-ink-2 max-w-[56ch] mt-7 mb-0"
            style="font-variation-settings: 'opsz' 22"
          >
            The Value Creation Protocol is a peer-level open protocol for value creation in AI-native
            organizations — authored, refined, and operated by Value-First Team. Read, cite, and run
            it on your own work.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a href="/encoding-stack" class="vcp-btn vcp-btn-primary">
              Read the spec <span aria-hidden="true">→</span>
            </a>
            <a href="/protocol-stack" class="vcp-btn vcp-btn-ghost">
              See the protocol stack <span aria-hidden="true" class="text-vcp-teal-deep">→</span>
            </a>
          </div>
        </div>

        <!-- At a glance sidecar -->
        <aside class="rounded-vcp-lg border border-vcp-border bg-vcp-paper p-8">
          <h4 class="font-sans text-[13px] font-medium tracking-[0.06em] uppercase text-vcp-ink-3 m-0 mb-5">
            At a glance
          </h4>
          <dl class="grid gap-4 m-0">
            {AT_A_GLANCE.map((row) => (
              <div>
                <dt class="font-mono text-[11px] tracking-[0.06em] uppercase text-vcp-ink-4 mb-1">{row.label}</dt>
                <dd class="m-0 font-display text-[16px] leading-snug text-vcp-ink" style="font-variation-settings: 'opsz' 16">{row.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============= § 01 · THE STACK ============= -->
  <section class="border-b border-vcp-border">
    <div class="max-w-vcp-content mx-auto px-6 py-20 md:py-24">
      <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16 items-baseline mb-12">
        <div>
          <p class="font-mono text-[12px] tracking-[0.14em] uppercase text-vcp-teal-deep m-0">
            § 01 · The Stack
          </p>
        </div>
        <div>
          <h2
            class="font-display text-[clamp(2rem,3.5vw,3rem)] font-medium leading-[1.05] tracking-vcp-h text-vcp-ink m-0"
            style="font-variation-settings: 'opsz' 48"
          >
            Three peer protocols.<br />No hierarchy implied.
          </h2>
          <p
            class="font-display text-[18px] leading-[1.55] text-vcp-ink-2 max-w-[56ch] mt-5 mb-0"
            style="font-variation-settings: 'opsz' 18"
          >
            MCP is the machine-context layer. HCP is the human-context layer. VCP is the
            value-creation layer — what creates value, for whom, and why. They are peers because
            each addresses a layer the others don't reach.
          </p>
        </div>
      </div>
      <ProtocolStackDiagram />
    </div>
  </section>

  <!-- ============= § 02 · ENTER HERE ============= -->
  <section class="border-b border-vcp-border">
    <div class="max-w-vcp-content mx-auto px-6 py-20 md:py-24">
      <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16 items-baseline">
        <div>
          <p class="font-mono text-[12px] tracking-[0.14em] uppercase text-vcp-teal-deep m-0 mb-3">
            § 02 · Enter Here
          </p>
          <h2
            class="font-display text-[clamp(2rem,3.5vw,3rem)] font-medium leading-[1.05] tracking-vcp-h text-vcp-ink m-0"
            style="font-variation-settings: 'opsz' 48"
          >
            Three doors in.
          </h2>
        </div>
        <p
          class="font-display text-[18px] leading-[1.55] text-vcp-ink-2 max-w-[52ch] m-0"
          style="font-variation-settings: 'opsz' 18"
        >
          The protocol resolves at three different reading depths. Pick one. The others remain
          navigable from any page.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-3 gap-6 md:gap-8">
        {ENTRY_CARDS.map((card) => (
          <a
            href={card.href}
            class="group flex flex-col gap-4 p-9 rounded-vcp-lg border border-vcp-border bg-vcp-paper no-underline text-inherit transition-all duration-200 hover:border-vcp-ink hover:-translate-y-0.5 min-h-[280px]"
          >
            <span class="font-mono text-[11px] tracking-[0.14em] text-vcp-teal-deep">{card.num} · {card.eyebrow}</span>
            <h3
              class="font-display text-[28px] md:text-[30px] font-medium leading-[1.15] tracking-vcp-h text-vcp-ink m-0"
              style="font-variation-settings: 'opsz' 30"
            >
              {card.title}
            </h3>
            <p
              class="font-display text-[16px] leading-[1.55] text-vcp-ink-2 m-0"
              style="font-variation-settings: 'opsz' 17"
            >
              {card.body}
            </p>
            <div class="mt-auto pt-4 border-t border-vcp-border flex justify-between items-center font-mono text-[11px] tracking-[0.06em] text-vcp-ink-3 uppercase">
              <span>{card.meta}</span>
              <span class="text-vcp-teal-deep text-lg">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============= FIVE LOAD-BEARING CLAIMS ============= -->
  <section class="bg-vcp-surface-2 border-b border-vcp-border">
    <div class="max-w-vcp-content mx-auto px-6 py-20 md:py-24">
      <div class="max-w-3xl">
        <p class="font-mono text-[12px] tracking-[0.14em] uppercase text-vcp-teal-deep m-0 mb-3">
          § 03 · Five Load-Bearing Claims
        </p>
        <h2
          class="font-display text-[clamp(2rem,3.5vw,3rem)] font-medium leading-[1.05] tracking-vcp-h text-vcp-ink m-0"
          style="font-variation-settings: 'opsz' 48"
        >
          What VCP claims
        </h2>
        <p
          class="font-display text-[18px] leading-[1.55] text-vcp-ink-2 m-0 mt-5 max-w-[56ch]"
          style="font-variation-settings: 'opsz' 18"
        >
          VCP distinguishes itself from industrial-age operating protocols through five claims.
          Each is a contrastive position, not a slogan.
        </p>
      </div>

      <ol class="mt-12 grid md:grid-cols-2 gap-6 list-none p-0 m-0">
        {FIVE_CLAIMS.map((claim) => (
          <li class="bg-vcp-paper border border-vcp-border rounded-vcp-lg p-7">
            <span class="font-mono text-[11px] tracking-[0.14em] text-vcp-teal-deep block mb-2">{claim.n}</span>
            <h3
              class="font-display text-[22px] font-medium leading-snug text-vcp-ink m-0"
              style="font-variation-settings: 'opsz' 22"
            >
              {claim.title}
            </h3>
            <p class="text-[15px] text-vcp-ink-2 mt-2 mb-0 leading-relaxed">{claim.body}</p>
          </li>
        ))}
      </ol>

      <p class="text-sm text-vcp-ink-3 mt-10 italic max-w-3xl">
        Full canonical reference:{' '}
        <a href="/positioning" class="text-vcp-ink-2 underline">Value Creation Protocol Positioning Paper</a>{' '}
        · <a href="/encoding-stack" class="text-vcp-ink-2 underline">Encoding stack overview</a>
      </p>
    </div>
  </section>

  <!-- ============= IMPLEMENTERS / ENGAGEMENT ============= -->
  <section class="bg-vcp-ink text-vcp-surface">
    <div class="max-w-vcp-content mx-auto px-6 py-20 md:py-24">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <div>
          <p class="font-mono text-[12px] tracking-[0.14em] uppercase text-vcp-teal m-0 mb-3">
            Implementers
          </p>
          <h2
            class="font-display text-[clamp(2rem,3.5vw,2.75rem)] font-medium leading-[1.1] tracking-vcp-h m-0"
            style="font-variation-settings: 'opsz' 44"
          >
            The protocol is open.<br />The implementation is opinionated.
          </h2>
          <p class="font-display text-[17px] leading-[1.65] mt-6 mb-0 opacity-90" style="font-variation-settings: 'opsz' 19">
            VCP was originated and is canonically implemented by{' '}
            <a href={SITE.implementer.url} target="_blank" rel="noopener" class="text-vcp-teal border-b border-vcp-teal no-underline">
              Value-First Team
            </a>. Anyone can read it, implement it, and contribute. The team that wrote it operates
            as the canonical implementing firm — not because VCP requires it, but because
            protocols benefit from a reference implementation.
          </p>
        </div>
        <div>
          <p class="font-mono text-[12px] tracking-[0.14em] uppercase text-vcp-ink-4 m-0 mb-3">
            Engage
          </p>
          <ul class="space-y-4 list-none p-0 m-0">
            <li class="text-[16px] leading-relaxed">
              <strong class="text-white">Read</strong> — start with the{' '}
              <a href="/positioning" class="text-vcp-teal underline">positioning paper</a>{' '}
              or the <a href="/encoding-stack" class="text-vcp-teal underline">encoding stack</a>.
            </li>
            <li class="text-[16px] leading-relaxed">
              <strong class="text-white">Implement</strong> — apply VCP in your own organization
              using the methodology canon as reference.
            </li>
            <li class="text-[16px] leading-relaxed">
              <strong class="text-white">Contribute</strong> — propose lexicon entries, VCP-Lang
              refinements, or Value Graph extensions.
            </li>
            <li class="text-[16px] leading-relaxed">
              <strong class="text-white">Reach the canonical implementer</strong> — for engaged
              implementation help, the team is at{' '}
              <a href={SITE.implementer.url} target="_blank" rel="noopener" class="text-vcp-teal underline">valuefirstteam.com</a>.
            </li>
          </ul>
          <p class="mt-8 mb-0">
            <a href="/engagement" class="vcp-btn" style="background: transparent; color: var(--vcp-surface); border: 1px solid rgba(246, 243, 236, 0.3);">
              Engagement pathway <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
