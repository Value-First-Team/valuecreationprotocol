---
/**
 * /vcp-lang — VCP-Lang v0.1 (Layer B of the encoding stack).
 *
 * Renders staged markdown vcp-lang-canon-v0_1.md. Sanity metadata from
 * the `vcp-lang-v0-1` doc when available.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../lib/markdown';
import { getCanonDoc } from '../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.vcpLang);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('vcp-lang-v0-1');

const version = meta?.version ?? 'v0.1';
const status = meta?.status ?? 'Active';
const effectiveDate = meta?.effectiveDate;
---

<BaseLayout
  title="VCP-Lang"
  description="The grammar for declaring Values, Context, and Trust in parseable syntax. Layer B of the VCP encoding stack — descended from the March 2026 HCP-Lang work."
  path="/vcp-lang"
  ogImage="og-vcp-lang.jpg"
  schemaType="TechArticle"
>
  <PageContainer>
    <PageHeader
      eyebrow="Encoding Stack · Layer B — Structural"
      title="VCP-Lang"
      lede="The grammar for declaring Values, Context, and Trust in parseable syntax. AI systems can read, validate, and execute against VCP-Lang declarations."
      version={version}
      status={status}
      effectiveDate={effectiveDate}
    />

    <nav class="mb-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone-600">
      <a href="/lexicon" class="text-stone-700 underline">← Lexicon (Layer A)</a>
      <a href="/encoding-stack" class="text-stone-700 underline">Encoding stack overview</a>
      <a href="/value-graph" class="text-stone-700 underline">Next: Value Graph (Layer C) →</a>
    </nav>

    <Prose html={html} />
  </PageContainer>
</BaseLayout>
