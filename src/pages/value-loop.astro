---
/**
 * /value-loop — Value Loop canonical reference.
 *
 * Discover → Codify → Deliver → Learn — continuous, not phased.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import CrossCitation from '../components/CrossCitation.astro';
import Implementers from '../components/Implementers.astro';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const { html: rawHtml } = renderWikiCanonical(WIKI_CANONICAL.valueLoop);
const html = stripFirstH1(rawHtml);
---

<BaseLayout
  title="Value Loop"
  description="Discover → Codify → Deliver → Learn. The continuous loop that replaces sequential delivery and phased rollouts."
  path="/value-loop"
  ogImage="og-value-loop.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Value Loop"
>
  <PageContainer>
    <PageHeader
      eyebrow="Methodology canon · Chapter 06 of 12"
      title="Value Loop"
      lede="Discover → Codify → Deliver → Learn. A continuous loop, not a sequential delivery pipeline. The unit of organizational learning in AI-native operations."
      version="v1"
      status="Canon"
      verified="12 May 2026"
      citeUrl="valuecreationprotocol.com/value-loop"
    />

    <Prose html={html} canon />

    <CrossCitation path="/value-loop" />
    <Implementers />
  </PageContainer>
</BaseLayout>
