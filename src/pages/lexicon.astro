---
/**
 * /lexicon — VFT Lexicon v0.1 (Layer A of the encoding stack).
 *
 * Renders staged markdown vft-lexicon-canon-v0_1.md. Sanity metadata from
 * the `lexicon-v0-1` doc when available.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import CrossCitation from '../components/CrossCitation.astro';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../lib/markdown';
import { getCanonDoc } from '../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.lexicon);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('lexicon-v0-1');

const version = meta?.version ?? 'v0.1';
const status = meta?.status ?? 'Active';
const effectiveDate = meta?.effectiveDate;
---

<BaseLayout
  title="VFT Lexicon"
  description="The structured vocabulary of VCP — Layer A of the encoding stack. Each entry encodes a load-bearing term with its industrial counterpart, operational definition, and contrastive training pairs."
  path="/lexicon"
  ogImage="og-lexicon.jpg"
  schemaType="TechArticle"
>
  <PageContainer>
    <PageHeader
      eyebrow="Encoding Stack · Layer A — Lexical"
      title="VFT Lexicon"
      lede="The structured vocabulary of the Value-First methodology, encoded so AI systems can recognize, declare, and execute against it."
      version={version}
      status={status}
      effectiveDate={effectiveDate}
    />

    <nav class="mb-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone-600">
      <a href="/encoding-stack" class="text-stone-700 underline">← Encoding stack overview</a>
      <a href="/vcp-lang" class="text-stone-700 underline">Next: VCP-Lang (Layer B) →</a>
      <a href="/value-graph" class="text-stone-700 underline">Then: Value Graph (Layer C) →</a>
    </nav>

    <Prose html={html} />

    <CrossCitation
      peerPath="/methodology/language-guide"
      peerLabel="Language guide at valuefirstteam.com"
    />
  </PageContainer>
</BaseLayout>
