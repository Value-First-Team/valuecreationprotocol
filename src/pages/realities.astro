---
/**
 * /realities — Value Realities.
 *
 * Source: Sanity valueReality records, ordered by number. Each reality
 * carries commitments and (where set) a relatedTrap pointer.
 *
 * Realities and Traps are paired. The Traps name what derails value
 * creation; the Realities name what supports it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CanonArchetype from '../components/CanonArchetype.astro';
import { getValueRealities } from '../lib/sanity/canon';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const realities = await getValueRealities();
const total = realities.length;

const { html: framingHtml } = renderWikiCanonical(WIKI_CANONICAL.valueRealities);
const framingBody = stripFirstH1(framingHtml);

const realityDefinedTerms = realities.map((r) => ({
  name: r.title ?? r.name ?? `Reality ${r.number ?? ''}`.trim(),
  description: r.summary,
  termCode: r.slug?.current ?? `reality-${r.number ?? ''}`,
}));
---

<BaseLayout
  title="Value Realities"
  description="The operational realities of value creation in AI-native systems. Each reality is paired with the Complexity Trap it counters and the commitments it implies."
  path="/realities"
  ogImage="og-realities.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Value Realities"
  schemaDefinedTerms={realityDefinedTerms}
>
  <CanonArchetype
    eyebrow="Value Realities"
    title="The realities a value-creating organization operates against."
    lead="Each reality names a condition that holds in AI-native value creation — and the operational commitments that condition demands. Realities are paired with the Complexity Traps they counter; reading them as pairs is the canonical way to consume them."
    path="/realities"
    specMeta={[
      { label: 'Status', value: 'canonical' },
      { label: 'Verified', value: '12 May 2026' },
      { label: 'Cite', value: 'valuecreationprotocol.com/realities' },
      { label: 'Count', value: `${total} realities · ordered by number` },
    ]}
  >
    <section class="canon-prose">
      <p>
        Realities are statements about how value actually flows when an organization
        stops fighting the underlying physics. Each reality is paired with a
        Complexity Trap — the same condition, read inverted. The Trap is what
        happens when a team operates as if the Reality were optional. The Reality
        is what an AI-native operating model assumes by default.
      </p>
      <p>
        Below each reality is a set of commitments. Commitments are operational —
        they describe what the team actually does when it accepts the reality. They
        are not aspirations. A team that does not honor the commitments has not
        accepted the reality.
      </p>
    </section>

    {total > 0 && (
      <>
        <p class="canon-section-label">The realities, in canonical order</p>
        <h2 class="canon-section-sub">Each reality, each commitment, each trap it counters.</h2>
        <p class="canon-section-note">
          Sourced from Sanity. Ordered by canonical number. Each carries its own anchor.
        </p>

        <ol class="canon-records">
          {realities.map((r) => {
            const name = r.title ?? r.name ?? `Reality ${r.number ?? ''}`.trim();
            const slug = r.slug?.current ?? `reality-${r.number ?? ''}`;
            return (
              <li class="canon-record" id={slug}>
                <p class="canon-record-eyebrow">
                  Reality {r.number != null ? String(r.number).padStart(2, '0') : '·'}
                </p>
                <h3 class="canon-record-title">{name}</h3>
                {r.summary && (
                  <p class="canon-record-body">{r.summary}</p>
                )}
                {r.relatedTrap && (
                  <ul class="canon-record-tags">
                    <li>
                      <a
                        href={`/twelve-traps#${r.relatedTrap.slug?.current ?? ''}`}
                        class="canon-record-tag">
                        <span class="canon-record-tag-label">counters</span>{r.relatedTrap.name}
                      </a>
                    </li>
                  </ul>
                )}
                {r.commitments && r.commitments.length > 0 && (
                  <div class="canon-record-meta" style="grid-template-columns:1fr">
                    <div>
                      <p class="canon-record-meta-label">Commitments</p>
                      <ol class="canon-record-meta-list" style="list-style:none;padding-left:0">
                        {r.commitments.map((c) => (
                          <li>
                            <strong style="color:var(--vcp-ink);font-weight:600">
                              {String(c.number).padStart(2, '0')} — {c.title}
                            </strong>
                            {c.actions && c.actions.length > 0 && (
                              <ul style="list-style:none;padding-left:1rem;margin:0.4em 0 0">
                                {c.actions.map((a) => (
                                  <li style="color:var(--vcp-ink-3);font-size:0.9375rem;padding:0.15em 0">
                                    → {a}
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ol>
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </>
    )}

    <div class="canon-callout">
      <p class="canon-callout-label">Where this fits</p>
      <p class="canon-callout-body">
        Realities pair one-for-one with the <a href="/twelve-traps">Twelve Complexity Traps</a>.
        The trap names the failure mode; the reality names the operating assumption that
        prevents it. Read them as pairs.
      </p>
    </div>

    <section class="canon-prose" set:html={framingBody} />
  </CanonArchetype>
</BaseLayout>
