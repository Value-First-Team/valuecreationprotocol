---
/**
 * /value-path — The eight stages from Audience to Champion.
 *
 * Source: Sanity valuePathStage records (Tier 1 canonical) +
 *         wiki canonical reference v1.1 for the framing prose.
 *
 * Layout: hero, value-path diagram, two-part per-record render
 * (Path TO Value 1–4 → Value Activated pivot → Path OF Value 5–8),
 * cross-citation (live: /value-path on valuefirstteam.com),
 * implementer attribution.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CanonArchetype from '../components/CanonArchetype.astro';
import { getValuePathStages } from '../lib/sanity/canon';

const stages = await getValuePathStages();
const PATH_TO = stages.filter((s) => s.number <= 4);
const PATH_OF = stages.filter((s) => s.number >= 5);

// Per-stage DefinedTerm entries for the auxiliary JSON-LD graph.
const stageDefinedTerms = stages.map((s) => ({
  name: `${s.name} (Value Path Stage ${s.number})`,
  description: s.mantra ? `"${s.mantra}" — ${s.description ?? ''}`.trim() : s.description,
  termCode: `vp-${s.number}`,
}));
---

<BaseLayout
  title="Value Path"
  description="The eight-stage journey from first signal through champion. Path TO Value (1–4) precedes Path OF Value (5–8). The canonical map of how a person naturally progresses through value discovery and creation."
  path="/value-path"
  ogImage="og-value-path.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Value Path"
  schemaDefinedTerms={stageDefinedTerms}
>
  <CanonArchetype
    eyebrow="The Value Path"
    title="Eight stages of natural progression."
    lead="A person moves through value discovery and creation in eight observable stages. Path TO Value (1–4) is discovery and evaluation. Path OF Value (5–8) is creation and multiplication. The pivot — Value Activated — is the moment of commitment. Each stage carries its own mantra, its own signals of readiness, and its own operating commitments."
    path="/value-path"
    specMeta={[
      { label: 'Status', value: 'v1.1 · canonical' },
      { label: 'Verified', value: '12 May 2026' },
      { label: 'Cite', value: 'valuecreationprotocol.com/value-path' },
      { label: 'Stages', value: '8 — sourced from canon' },
    ]}
  >
    <figure class="canon-figure">
      <div class="canon-figure-frame">
        <img
          src="/diagrams/value-path.svg"
          alt="The eight Value Path stages, from Audience through Champion, with the Value Activated pivot between Path TO (1–4) and Path OF (5–8)."
          loading="lazy"
        />
      </div>
      <figcaption class="canon-figure-caption">
        Path TO Value (1–4) → Value Activated → Path OF Value (5–8)
      </figcaption>
    </figure>

    <section class="canon-prose">
      <p>
        The Value Path describes how humans actually move through relationships with an
        organization — not how an industrial-age operating model assumes they should.
        It honors readiness over manufactured advancement, signals over scores, and
        natural progression over engineered pressure.
      </p>
      <p>
        Each stage is observable. A person occupies one stage at a time. The transitions
        are quiet: a Researcher does not announce that they have moved into Hand Raiser;
        they simply ask a different kind of question. The protocol reads those questions.
      </p>
      <p>
        The eight stages render below as canonical records. Each carries its own anchor
        URL — meaning a practitioner in a client meeting can cite a single stage directly
        without losing context (for example,
        <a href="#hand-raiser">valuecreationprotocol.com/value-path#hand-raiser</a>).
      </p>
    </section>

    <p class="canon-section-label" id="path-to">Path TO Value</p>
    <h2 class="canon-section-sub">Stages 1 through 4 — discovery and evaluation.</h2>
    <p class="canon-section-note">
      A person moves from observable signal to commitment. This is the pre-Value-Activated
      phase. Sourcing happens here; pressure does not belong here.
    </p>

    {PATH_TO.length > 0 && (
      <ol class="canon-records">
        {PATH_TO.map((s) => {
          const slug = s.slug?.current ?? s.name.toLowerCase().replace(/\s+/g, '-');
          return (
            <li class="canon-record" id={slug}>
              <p class="canon-record-eyebrow">Stage {String(s.number).padStart(2, '0')}</p>
              <h3 class="canon-record-title">{s.name}</h3>
              {s.mantra && (
                <p class="canon-record-mantra">"{s.mantra}"</p>
              )}
              {s.description && (
                <p class="canon-record-body">{s.description}</p>
              )}
              {(s.signalsOfReadiness?.length || s.typicalChallenges?.length) && (
                <div class="canon-record-meta">
                  {s.signalsOfReadiness && s.signalsOfReadiness.length > 0 && (
                    <div>
                      <p class="canon-record-meta-label">Signals of readiness</p>
                      <ul class="canon-record-meta-list">
                        {s.signalsOfReadiness.map((sig) => <li>{sig}</li>)}
                      </ul>
                    </div>
                  )}
                  {s.typicalChallenges && s.typicalChallenges.length > 0 && (
                    <div>
                      <p class="canon-record-meta-label">Typical challenges</p>
                      <ul class="canon-record-meta-list">
                        {s.typicalChallenges.map((c) => <li>{c}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              )}
              {s.typicalTraps && s.typicalTraps.length > 0 && (
                <ul class="canon-record-tags">
                  {s.typicalTraps.map((t: any) => (
                    <li>
                      <a href={`/twelve-traps#${t.slug?.current ?? ''}`} class="canon-record-tag">
                        <span class="canon-record-tag-label">trap</span>{t.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ol>
    )}

    <div class="canon-pivot">
      <p class="canon-pivot-mark">▼  Value Activated  ▼</p>
      <p class="canon-pivot-note">
        The relationship transitions from commitment to receiving value. Path TO ends here; Path OF begins.
      </p>
    </div>

    <p class="canon-section-label" id="path-of">Path OF Value</p>
    <h2 class="canon-section-sub">Stages 5 through 8 — creation and multiplication.</h2>
    <p class="canon-section-note">
      Value flows. The relationship matures from implementer to champion. This is where
      industrial-age operating models go quiet; the protocol pays attention.
    </p>

    {PATH_OF.length > 0 && (
      <ol class="canon-records">
        {PATH_OF.map((s) => {
          const slug = s.slug?.current ?? s.name.toLowerCase().replace(/\s+/g, '-');
          return (
            <li class="canon-record" id={slug}>
              <p class="canon-record-eyebrow">Stage {String(s.number).padStart(2, '0')}</p>
              <h3 class="canon-record-title">{s.name}</h3>
              {s.mantra && (
                <p class="canon-record-mantra">"{s.mantra}"</p>
              )}
              {s.description && (
                <p class="canon-record-body">{s.description}</p>
              )}
              {(s.signalsOfReadiness?.length || s.typicalChallenges?.length) && (
                <div class="canon-record-meta">
                  {s.signalsOfReadiness && s.signalsOfReadiness.length > 0 && (
                    <div>
                      <p class="canon-record-meta-label">Signals of readiness</p>
                      <ul class="canon-record-meta-list">
                        {s.signalsOfReadiness.map((sig) => <li>{sig}</li>)}
                      </ul>
                    </div>
                  )}
                  {s.typicalChallenges && s.typicalChallenges.length > 0 && (
                    <div>
                      <p class="canon-record-meta-label">Typical challenges</p>
                      <ul class="canon-record-meta-list">
                        {s.typicalChallenges.map((c) => <li>{c}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              )}
              {s.typicalTraps && s.typicalTraps.length > 0 && (
                <ul class="canon-record-tags">
                  {s.typicalTraps.map((t: any) => (
                    <li>
                      <a href={`/twelve-traps#${t.slug?.current ?? ''}`} class="canon-record-tag">
                        <span class="canon-record-tag-label">trap</span>{t.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ol>
    )}

    <div class="canon-callout">
      <p class="canon-callout-label">Related canon</p>
      <p class="canon-callout-body">
        Read the <a href="/twelve-traps">Twelve Complexity Traps</a> to see what derails
        natural progression. Read <a href="/realities">Value Realities</a> for the
        operational commitments each stage demands.
      </p>
    </div>
  </CanonArchetype>
</BaseLayout>
