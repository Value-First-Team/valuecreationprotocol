---
/**
 * /positioning — VCP Positioning Paper.
 *
 * Manifesto archetype with a protocol-stack diagram aside — this paper sits
 * between manifesto (positional, long-form, declarative) and canon (technical
 * reference). The manifesto hero leads; the diagram surfaces inline.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ManifestoHero from '../components/ManifestoHero.astro';
import Prose from '../components/Prose.astro';
import Diagram from '../components/Diagram.astro';
import Implementers from '../components/Implementers.astro';
import { PROTOCOL_PEERS } from '../lib/site';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../lib/markdown';
import { getCanonDoc } from '../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.positioning);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('vcp-positioning-paper');

const effectiveDate = meta?.effectiveDate ?? '2026';
---

<BaseLayout
  title="Positioning Paper"
  description="Where the Value Creation Protocol sits in the AI-native protocol stack — alongside MCP and HCP — and why it exists."
  path="/positioning"
  ogImage="og-positioning.jpg"
  schemaType="TechArticle"
  minimalNav
>
  <ManifestoHero
    date={effectiveDate}
    position="03 of 03"
    pullQuote={'The protocol stack is <strong>not a hierarchy.</strong> It is a set of peers.'}
    author="Value-First Team"
    filedUnder="Positioning · Protocol Stack"
    citeUrl="valuecreationprotocol.com/positioning"
    readTime="14 MIN"
  />

  <section class="max-w-vcp-content mx-auto px-6 md:px-8 mb-20">
    <div class="grid lg:grid-cols-[1fr_320px] gap-12 items-start">
      <div class="rounded-vcp-lg border border-vcp-border bg-vcp-paper p-6">
        <Diagram
          name="protocol-stack"
          alt="Protocol stack: MCP (capability), HCP (human context), VCP (methodology)"
          caption="Capability, context, methodology — read bottom-up."
        />
      </div>
      <aside class="rounded-vcp-lg border border-vcp-border-strong bg-vcp-surface-2 p-7">
        <p class="font-mono text-[10px] tracking-[0.14em] uppercase text-vcp-ink-3 m-0 mb-3">
          THE STACK
        </p>
        <p class="font-display text-[16px] leading-[1.55] text-vcp-ink m-0" style="font-variation-settings: 'opsz' 18">
          VCP sits atop{' '}
          <a href={PROTOCOL_PEERS.mcp.url} target="_blank" rel="noopener noreferrer" class="text-vcp-teal-deep border-b border-vcp-teal-deep no-underline">{PROTOCOL_PEERS.mcp.short}</a>{' '}
          (capability) and{' '}
          <a href={PROTOCOL_PEERS.hcp.url} target="_blank" rel="noopener noreferrer" class="text-vcp-teal-deep border-b border-vcp-teal-deep no-underline">{PROTOCOL_PEERS.hcp.short}</a>{' '}
          (human context). Each layer is independent; together they form the substrate
          for AI-native operations.
        </p>
      </aside>
    </div>
  </section>

  <article class="max-w-[720px] mx-auto px-6 md:px-8 pb-32">
    <Prose html={html} manifesto />

    <Implementers variant="manifesto" />
  </article>
</BaseLayout>
