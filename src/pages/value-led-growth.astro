---
/**
 * /value-led-growth — Value-Led Growth canonical framework reference.
 *
 * Source: src/content/wiki-canonical/value-led-growth-canonical-reference.md
 *
 * Distinct from /manifestos/value-led-growth (manifesto treatment).
 * This page is the framework canon — declarative and operable.
 *
 * Cross-citation suppressed (valuefirstteam.com/value-led-growth returns 404;
 * verified 2026-05-12). Will re-enable when Showcase ships firm-side page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CanonArchetype from '../components/CanonArchetype.astro';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const { html } = renderWikiCanonical(WIKI_CANONICAL.valueLedGrowth);
const bodyHtml = stripFirstH1(html);
---

<BaseLayout
  title="Value-Led Growth"
  description="The growth framework an AI-native organization adopts. Growth as the natural consequence of value created across mutual stakeholders. Paired operationally with the Value Path."
  path="/value-led-growth"
  ogImage="og-value-led-growth.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Value-Led Growth"
>
  <CanonArchetype
    eyebrow="Value-Led Growth"
    title="Growth as the consequence of value created."
    lead="Value-Led Growth is the operating framework that replaces industrial-age growth motions. Growth happens because value flowed — through customers, through practitioners, through the firm itself — and the protocol made that flow legible. This page is the framework canon. The accompanying manifesto reads it aloud."
    path="/value-led-growth"
    specMeta={[
      { label: 'Status', value: 'v1.0 · canonical' },
      { label: 'Verified', value: '12 May 2026' },
      { label: 'Cite', value: 'valuecreationprotocol.com/value-led-growth' },
      { label: 'See also', value: '/manifestos/value-led-growth' },
    ]}
  >
    <div class="canon-callout">
      <p class="canon-callout-label">Two reads of the same idea</p>
      <p class="canon-callout-body">
        This page is the operating canon — declarative and addressable. For the
        long-form manifesto treatment, see
        <a href="/manifestos/value-led-growth">Value-Led Growth manifesto</a>.
      </p>
    </div>

    <section class="canon-prose" set:html={bodyHtml} />

    <div class="canon-callout">
      <p class="canon-callout-label">Where this fits</p>
      <p class="canon-callout-body">
        Read alongside the <a href="/value-path">Value Path</a>: the Path is the
        relational map; Value-Led Growth is what compounds across it. The
        <a href="/value-loop">Value Loop</a> is the cadence.
      </p>
    </div>
  </CanonArchetype>
</BaseLayout>
