---
/**
 * /value-led-growth — Value-Led Growth canonical framework reference.
 *
 * Distinct from /manifestos/value-led-growth (manifesto treatment).
 * This is the framework canon.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import CrossCitation from '../components/CrossCitation.astro';
import Implementers from '../components/Implementers.astro';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const { html: rawHtml } = renderWikiCanonical(WIKI_CANONICAL.valueLedGrowth);
const html = stripFirstH1(rawHtml);
---

<BaseLayout
  title="Value-Led Growth"
  description="The framework that replaces lead generation. Growth as a consequence of value created across mutual stakeholders."
  path="/value-led-growth"
  ogImage="og-value-led-growth.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Value-Led Growth"
>
  <PageContainer>
    <PageHeader
      eyebrow="Methodology canon · Chapter 10 of 12"
      title="Value-Led Growth"
      lede="A framework, not a slogan. Growth as a consequence of value created across mutual stakeholders. Pairs with the Value Path on the relational side."
      status="Canon"
      verified="12 May 2026"
      citeUrl="valuecreationprotocol.com/value-led-growth"
    />

    <aside class="mb-10 p-4 rounded-lg bg-stone-50 border border-stone-200 text-sm text-stone-600">
      Looking for the long-form manifesto? See
      <a href="/manifestos/value-led-growth" class="text-stone-700 underline">Value-Led Growth manifesto</a>.
      This page is the canonical framework reference.
    </aside>

    <Prose html={html} canon />

    <CrossCitation path="/value-led-growth" />
    <Implementers />
  </PageContainer>
</BaseLayout>
