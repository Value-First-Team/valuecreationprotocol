---
/**
 * /manifestos/value-led-growth — Value-Led Growth Manifesto.
 *
 * Distinct from /value-led-growth (the framework canon page).
 * This is the long-form manifesto treatment in the Manifesto.jsx archetype.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManifestoHero from '../../components/ManifestoHero.astro';
import Prose from '../../components/Prose.astro';
import Implementers from '../../components/Implementers.astro';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../../lib/markdown';
import { getCanonDoc } from '../../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.valueLedGrowth);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('value-led-growth-manifesto');

const effectiveDate = meta?.effectiveDate ?? '2026';
---

<BaseLayout
  title="Value-Led Growth Manifesto"
  description="A manifesto for organizational transformation in the AI era. Growth as a consequence of value created, not a function pursued."
  path="/manifestos/value-led-growth"
  ogImage="og-manifestos-value-led-growth.jpg"
  schemaType="Article"
  minimalNav
>
  <ManifestoHero
    date={effectiveDate}
    position="02 of 03"
    pullQuote={'Growth is <strong>what happens</strong> when value created exceeds value extracted.'}
    author="Value-First Team"
    filedUnder="Manifestos · Growth"
    citeUrl="valuecreationprotocol.com/manifestos/value-led-growth"
    readTime="11 MIN"
  />

  <article class="max-w-[720px] mx-auto px-6 md:px-8 pb-32">
    <Prose html={html} manifesto />

    <nav class="mt-20 pt-10 border-t border-vcp-border flex flex-wrap gap-x-8 gap-y-3 font-mono text-[11px] tracking-[0.08em] uppercase text-vcp-ink-3">
      <a href="/value-led-growth" class="text-vcp-ink-3 no-underline hover:text-vcp-ink">Value-Led Growth framework canon →</a>
      <a href="/manifestos/beyond-leads" class="text-vcp-ink-3 no-underline hover:text-vcp-ink">Beyond "Leads" manifesto →</a>
      <a href="/positioning" class="text-vcp-ink-3 no-underline hover:text-vcp-ink">Positioning paper →</a>
    </nav>

    <Implementers variant="manifesto" />
  </article>
</BaseLayout>
