---
/**
 * /manifestos/value-led-growth — Value-Led Growth: A Manifesto for
 * Organizational Transformation in the AI Era.
 *
 * Distinct from /value-led-growth (the methodology canon page). This is the
 * position piece — the argument that "growth" is reframed as what happens
 * when value created exceeds value extracted.
 *
 * Body source: src/content/canon/value-led-growth-manifesto.md
 * Sanity meta: value-led-growth-manifesto (strategicDocument)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManifestoArchetype from '../../components/ManifestoArchetype.astro';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../../lib/markdown';
import { getCanonDoc } from '../../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.valueLedGrowth);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('value-led-growth-manifesto');

let eyebrowDate: string | undefined;
let isoDate: string | undefined;
if (meta?.effectiveDate) {
  isoDate = meta.effectiveDate;
  const d = new Date(meta.effectiveDate);
  if (!isNaN(d.getTime())) {
    eyebrowDate = d.toLocaleString('en-US', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });
  }
}
---

<BaseLayout
  title="Value-Led Growth"
  description="Organizational complexity has become the product. A manifesto for the transformation that turns capability, context, and intent into value created — for customers, for teams, for the business."
  path="/manifestos/value-led-growth"
  ogImage="og-manifestos-value-led-growth.jpg"
  schemaType="Article"
  datePublished={isoDate}
  minimalNav
>
  <ManifestoArchetype
    eyebrowDate={eyebrowDate}
    title="Value-Led Growth"
    lead="Organizational complexity has quietly become the product — the thing that consumes resources, demands attention, and shapes every decision. Growth, properly understood, is what happens when an organization stops manufacturing complexity and starts creating value."
    byline="Value-First Team"
    filedUnder="Manifestos · Growth"
    path="/manifestos/value-led-growth"
  >
    <section slot="pull-quote" class="manifesto-pullquote">
      <div class="manifesto-pullquote-inner">
        <p class="manifesto-pullquote-body">
          Growth is <strong>what happens</strong> when value created exceeds value extracted.
        </p>
      </div>
    </section>

    <div class="manifesto-prose" set:html={html} />
  </ManifestoArchetype>
</BaseLayout>
