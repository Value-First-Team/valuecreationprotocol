---
/**
 * /manifestos — Manifesto hub.
 *
 * Hub archetype, Phase 5. Indexes the three manifesto-class pages:
 *   /manifestos/beyond-leads
 *   /manifestos/value-led-growth
 *   /positioning
 *
 * Each card surfaces a one-paragraph teaser (the manifesto's lead) and a
 * pull-quote excerpt — the strongest line — so the reader can match a
 * manifesto to a question before reading.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubArchetype from '../../components/HubArchetype.astro';
import { SITE } from '../../lib/site';

interface ManifestoEntry {
  num: string;
  eyebrow: string;        // mono caps category
  date: string;           // small mono date
  title: string;
  teaser: string;         // one-paragraph lead
  quote: string;          // pull-quote excerpt
  href: string;
  cta: string;            // foot meta label
}

// Pull-quote excerpts: each is the manifesto's strongest line, verbatim
// from the source page lead / body, lightly trimmed for card scale.
const MANIFESTOS: ManifestoEntry[] = [
  {
    num: '§ 01',
    eyebrow: 'Manifesto',
    date: 'Feb 2026',
    title: 'Beyond "Leads".',
    teaser:
      'The vocabulary at the center of modern business is older than software, and it has stopped working. The math of AI-native discovery has rendered the funnel illegible — to humans and to the agents who increasingly accompany them.',
    quote: 'The funnel is illegible — to humans and to the agents who increasingly accompany them.',
    href: '/manifestos/beyond-leads',
    cta: 'Read manifesto',
  },
  {
    num: '§ 02',
    eyebrow: 'Manifesto',
    date: 'Mar 2026',
    title: 'Value-Led Growth.',
    teaser:
      'Organizational complexity has quietly become the product — the thing that consumes resources, demands attention, and shapes every decision. Growth, properly understood, is what happens when an organization stops manufacturing complexity and starts creating value.',
    quote: 'Growth is what happens when an organization stops manufacturing complexity and starts creating value.',
    href: '/manifestos/value-led-growth',
    cta: 'Read manifesto',
  },
  {
    num: '§ 03',
    eyebrow: 'Positioning paper',
    date: 'May 2026',
    title: 'Where VCP sits in the stack.',
    teaser:
      'Two protocols have emerged to solve the layers below value creation: MCP for capability, HCP for human context. Neither one creates value on its own. Neither one was ever supposed to. This is the layer that does.',
    quote: 'MCP for capability. HCP for human context. VCP is the layer that creates value.',
    href: '/positioning',
    cta: 'Read paper',
  },
];

// Schema.org ItemList for the three manifesto-class artifacts.
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Manifestos and positioning',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: MANIFESTOS.length,
  itemListElement: MANIFESTOS.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.title,
    url: `${SITE.url}${m.href}`,
  })),
};
---

<BaseLayout
  title="Manifestos"
  description="Three long-form artifacts on why this protocol exists. Beyond Leads, Value-Led Growth, and the positioning paper."
  path="/manifestos"
  ogImage="og-manifestos.jpg"
  schemaType="CollectionPage"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <HubArchetype
    eyebrow="§ Manifestos · Index of 3"
    title="Why this protocol exists."
    lead="Three long-form artifacts arguing the case the protocol formalizes. Each names a condition the industrial-age vocabulary of growth cannot describe, and a frame an AI-native organization can operate from instead."
  >
    <ul class="hub-grid hub-grid-2">
      {MANIFESTOS.map((m) => (
        <li>
          <a href={m.href} class="hub-card">
            <p class="hub-card-eyebrow">{m.num} · {m.eyebrow} · {m.date}</p>
            <h2 class="hub-card-title">{m.title}</h2>
            <p class="hub-card-body">{m.teaser}</p>
            <blockquote class="hub-card-quote">{m.quote}</blockquote>
            <div class="hub-card-foot">
              <span class="hub-card-meta">{m.cta}</span>
              <span aria-hidden="true" class="hub-card-arrow">&rarr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </HubArchetype>
</BaseLayout>
