---
/**
 * /manifestos/beyond-leads — Beyond "Leads": A Manifesto for Humanized,
 * Collaborative Growth.
 *
 * The argument: the industrial-age vocabulary of B2B (leads, prospects,
 * funnels, conversions, MQLs, SQLs) cannot carry an AI-native organization.
 * The forbidden-vocab rule does not apply to manifesto prose that NAMES the
 * terms it argues against — the prose argues with them in cited context.
 *
 * Body source: src/content/canon/beyond_leads_manifesto_v2.md
 * Sanity meta: beyond-leads-manifesto-v2 (strategicDocument)
 *
 * Rendered through ManifestoArchetype — Phase 4 archetype, sibling to
 * CanonArchetype + SpecArchetype.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManifestoArchetype from '../../components/ManifestoArchetype.astro';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../../lib/markdown';
import { getCanonDoc } from '../../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.beyondLeads);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('beyond-leads-manifesto-v2');

/* Format effectiveDate as "Month YYYY" if present. No invented date if absent. */
let eyebrowDate: string | undefined;
let isoDate: string | undefined;
if (meta?.effectiveDate) {
  isoDate = meta.effectiveDate;
  const d = new Date(meta.effectiveDate);
  if (!isNaN(d.getTime())) {
    eyebrowDate = d.toLocaleString('en-US', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });
  }
}
---

<BaseLayout
  title='Beyond "Leads"'
  description="The industrial-age vocabulary of B2B cannot carry an AI-native organization. A manifesto for humanized, collaborative growth."
  path="/manifestos/beyond-leads"
  ogImage="og-manifestos-beyond-leads.jpg"
  schemaType="Article"
  datePublished={isoDate}
  minimalNav
>
  <ManifestoArchetype
    eyebrowDate={eyebrowDate}
    title='Beyond &ldquo;Leads&rdquo;'
    lead="The vocabulary at the center of modern business is older than software, and it has stopped working. The math of AI-native discovery has rendered the funnel illegible — to humans and to the agents who increasingly accompany them."
    byline="Value-First Team"
    filedUnder="Manifestos · Vocabulary"
    path="/manifestos/beyond-leads"
  >
    <section slot="pull-quote" class="manifesto-pullquote">
      <div class="manifesto-pullquote-inner">
        <p class="manifesto-pullquote-body">
          People never research alone anymore. They explore <strong>with</strong> Claude.
          They evaluate <strong>with</strong> ChatGPT. They draft implementation plans
          <strong>with</strong> AI assistants &mdash; all without ever entering your funnel.
        </p>
      </div>
    </section>

    <div class="manifesto-prose" set:html={html} />
  </ManifestoArchetype>
</BaseLayout>
