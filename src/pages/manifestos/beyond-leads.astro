---
/**
 * /manifestos/beyond-leads — Beyond "Leads" Manifesto v2.
 *
 * Renders staged markdown beyond_leads_manifesto_v2.md in the Manifesto.jsx
 * archetype: minimal nav, giant pull-quote hero, narrow body with loose
 * line-height and editorial drop-cap.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManifestoHero from '../../components/ManifestoHero.astro';
import Prose from '../../components/Prose.astro';
import Implementers from '../../components/Implementers.astro';
import { renderStagedMarkdown, stripFirstH1, STAGED_FILES } from '../../lib/markdown';
import { getCanonDoc } from '../../lib/sanity/canon';

const { html: rawHtml } = renderStagedMarkdown(STAGED_FILES.beyondLeads);
const html = stripFirstH1(rawHtml);
const meta = await getCanonDoc('beyond-leads-manifesto-v2');

const effectiveDate = meta?.effectiveDate ?? 'February 2026';
---

<BaseLayout
  title='Beyond "Leads"'
  description="A manifesto for humanized, collaborative growth. The industrial-age lead vocabulary is no longer load-bearing in an AI-native era."
  path="/manifestos/beyond-leads"
  ogImage="og-manifestos-beyond-leads.jpg"
  schemaType="Article"
  minimalNav
>
  <ManifestoHero
    date={effectiveDate}
    position="01 of 03"
    pullQuote={'"Leads" is what you call a human when you have <strong>forgotten</strong> how to ask their name.'}
    author="Value-First Team"
    filedUnder="Manifestos · Vocabulary"
    citeUrl="valuecreationprotocol.com/manifestos/beyond-leads"
    readTime="9 MIN"
  />

  <article class="max-w-[720px] mx-auto px-6 md:px-8 pb-32">
    <Prose html={html} manifesto />

    <nav class="mt-20 pt-10 border-t border-vcp-border flex flex-wrap gap-x-8 gap-y-3 font-mono text-[11px] tracking-[0.08em] uppercase text-vcp-ink-3">
      <a href="/manifestos/value-led-growth" class="text-vcp-ink-3 no-underline hover:text-vcp-ink">Value-Led Growth manifesto →</a>
      <a href="/positioning" class="text-vcp-ink-3 no-underline hover:text-vcp-ink">Positioning paper →</a>
      <a href="/realities" class="text-vcp-ink-3 no-underline hover:text-vcp-ink">Value Realities →</a>
    </nav>

    <Implementers variant="manifesto" />
  </article>
</BaseLayout>
