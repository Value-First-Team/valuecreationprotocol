---
/**
 * /methodology — Methodology hub.
 *
 * Lists all twelve methodology canon pages with brief summaries.
 * Card grid layout, no marketing decoration.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContainer from '../../components/PageContainer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { METHODOLOGY_PAGES } from '../../lib/site';
---

<BaseLayout
  title="Methodology Canon"
  description="The full methodology canon — twelve pages covering the frameworks VCP encodes."
  path="/methodology"
  ogImage="og-default.jpg"
  schemaType="CollectionPage"
>
  <PageContainer wide>
    <PageHeader
      eyebrow="Methodology"
      title="Methodology Canon"
      lede="The frameworks VCP encodes. Each page is a canonical reference — built over years of practice, now machine-readable through the encoding stack."
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {METHODOLOGY_PAGES.map((m) => (
        <a
          href={m.href}
          class="block p-5 md:p-6 rounded-lg border border-stone-200 hover:border-stone-400 hover:bg-stone-50 transition-colors no-underline"
        >
          <h2 class="text-base md:text-lg font-semibold m-0 text-stone-900 leading-snug">
            {m.label}
          </h2>
          <p class="text-sm text-stone-600 mt-2 mb-0 leading-relaxed">
            {m.summary}
          </p>
        </a>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
