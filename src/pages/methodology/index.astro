---
/**
 * /methodology — Methodology hub.
 *
 * Hub archetype — chrome + PageHeader hero, then a card grid of the
 * twelve canon pages.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContainer from '../../components/PageContainer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { METHODOLOGY_PAGES } from '../../lib/site';
---

<BaseLayout
  title="Methodology Canon"
  description="The full methodology canon — twelve pages covering the frameworks VCP encodes."
  path="/methodology"
  ogImage="og-default.jpg"
  schemaType="CollectionPage"
>
  <PageContainer wide>
    <PageHeader
      eyebrow="Methodology canon · Index of 12"
      title="Methodology Canon"
      lede="The frameworks VCP encodes. Each page is a canonical reference — built over years of practice, now machine-readable through the encoding stack."
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {METHODOLOGY_PAGES.map((m, i) => (
        <a
          href={m.href}
          class="group block p-6 md:p-7 rounded-vcp-lg border border-vcp-border bg-vcp-paper hover:border-vcp-ink hover:-translate-y-0.5 transition-all duration-200 no-underline text-inherit"
        >
          <span class="font-mono text-[11px] tracking-[0.14em] text-vcp-teal-deep block mb-3">
            CHAPTER {String(i + 1).padStart(2, '0')}
          </span>
          <h2
            class="font-display text-[20px] md:text-[22px] font-medium leading-snug text-vcp-ink m-0"
            style="font-variation-settings: 'opsz' 22"
          >
            {m.label}
          </h2>
          <p class="text-[15px] text-vcp-ink-2 mt-2 mb-0 leading-relaxed">
            {m.summary}
          </p>
        </a>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
