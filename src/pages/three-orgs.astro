---
/**
 * /three-orgs — Three-Org Model canonical reference.
 *
 * Customer Org, Operations Org, Finance Org. Every concern maps to one.
 * Renders wiki/canonical/three-org-model-canonical-reference.md (Chris-authored).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import Diagram from '../components/Diagram.astro';
import CrossCitation from '../components/CrossCitation.astro';
import Implementers from '../components/Implementers.astro';
import { renderWikiCanonical, stripFirstH1, WIKI_CANONICAL } from '../lib/markdown';

const { html: rawHtml } = renderWikiCanonical(WIKI_CANONICAL.threeOrg);
const html = stripFirstH1(rawHtml);
---

<BaseLayout
  title="Three-Org Model"
  description="Customer, Operations, Finance — every concern maps to one. The organizational framing that replaces functional silos."
  path="/three-orgs"
  ogImage="og-three-orgs.jpg"
  schemaType="DefinedTerm"
  schemaTermCode="Three-Org Model"
>
  <PageContainer wide>
    <PageHeader
      eyebrow="Methodology Canon"
      title="Three-Org Model"
      lede="Customer Org, Operations Org, Finance Org. Every business concern maps to one of the three. Functional silos dissolve into clear ownership."
      status="Canon"
    />

    <Diagram
      name="three-org"
      alt="The Three-Org Model: Customer, Operations, Finance"
      caption="Every concern, every agent, every BU maps to one of the three orgs."
    />

    <Prose html={html} />

    <CrossCitation path="/three-orgs" />
    <Implementers />
  </PageContainer>
</BaseLayout>
