---
/**
 * /beliefs — Five Core Beliefs (canonical Sanity records).
 *
 * Belief #5 is now Emergence over Predictability (position 5).
 * Legacy coreBelief-evolution is excluded by the position-ordering.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/PageContainer.astro';
import PageHeader from '../components/PageHeader.astro';
import CrossCitation from '../components/CrossCitation.astro';
import Implementers from '../components/Implementers.astro';
import { getCoreBeliefs } from '../lib/sanity/canon';

const beliefs = await getCoreBeliefs();
// Only show beliefs with a numeric position (1–5). Excludes legacy records.
const ordered = beliefs.filter((b) => typeof b.position === 'number' && b.position >= 1 && b.position <= 5);
---

<BaseLayout
  title="Five Core Beliefs"
  description="The philosophical foundations of the Value-First Framework — five 'X over Y' statements that distinguish VCP from industrial-age defaults."
  path="/beliefs"
  ogImage="og-beliefs.jpg"
  schemaType="TechArticle"
>
  <PageContainer wide>
    <PageHeader
      eyebrow="Methodology Canon"
      title="Five Core Beliefs"
      lede="The philosophical foundations of the Value-First Framework. Each belief is an 'X over Y' statement — the VCP-aligned approach over the industrial-age default."
      status="v1.0"
      effectiveDate="2025-12-08"
    />

    {ordered.length === 0 ? (
      <p class="text-stone-600">Belief records loading from canon.</p>
    ) : (
      <ol class="space-y-12 list-none p-0">
        {ordered.map((b) => (
          <li class="grid md:grid-cols-12 gap-8 items-start pb-12 border-b border-stone-100 last:border-0">
            <div class="md:col-span-3">
              <span class="font-mono text-vcp-teal text-sm">
                Belief {String(b.position).padStart(2, '0')}
              </span>
              <h2 class="text-xl md:text-2xl font-semibold text-stone-900 mt-2 mb-0 leading-tight">
                {b.name}
              </h2>
              {b.shortLabel && (
                <p class="text-sm text-stone-500 mt-2 mb-0 font-mono">
                  {b.shortLabel}
                </p>
              )}
            </div>
            <div class="md:col-span-9">
              {b.tagline && (
                <p class="text-lg md:text-xl text-stone-800 m-0 leading-relaxed font-medium">
                  {b.tagline}
                </p>
              )}
              <p class="text-sm text-stone-500 mt-6 mb-0">
                See <a href="/glossary#beliefs" class="text-stone-700 underline">glossary entry</a> ·
                Position #{b.position} in the canonical ordering.
              </p>
            </div>
          </li>
        ))}
      </ol>
    )}

    <CrossCitation path="/beliefs" />
    <Implementers />
  </PageContainer>
</BaseLayout>
